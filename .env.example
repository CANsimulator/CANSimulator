# Environment Variables — CAN Simulator
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ============================================================
# Frontend (Vite) - Supabase
# ============================================================
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ============================================================
# Frontend (Vite) - Razorpay (Client-side public key only)
# ============================================================
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
VITE_RAZORPAY_PLAN_PRO=plan_XXXX_pro
VITE_RAZORPAY_PLAN_TEAM=plan_XXXX_team

# ============================================================
# Backend/Testing - API Configuration
# ============================================================
API_BASE_URL=http://localhost:5173
API_TIMEOUT=30

# ============================================================
# Testing - Server Configuration
# ============================================================
# Vite dev server
DEV_SERVER_PORT=5173
DEV_SERVER_HOST=localhost

# Backend server (if using Node/Express backend)
BACKEND_PORT=3000
BACKEND_HOST=localhost

# ============================================================
# CAN Simulator Settings
# ============================================================
CAN_INTERFACE=can0
CAN_BAUDRATE=500000
SIMULATOR_DEBUG=False
SIMULATOR_HEADLESS=True

# ============================================================
# Storage and Caching
# ============================================================
CACHE_DIR=./cache
DATA_DIR=./data

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=./logs/simulator.log
# If using Vercel: leave empty (routes auto-resolve from /api)
# If using a separate backend: set the base URL
VITE_API_BASE_URL=

# ============================================================
# Vercel Analytics (optional)
# ============================================================
# No key needed — @vercel/analytics automatically instruments when deployed
